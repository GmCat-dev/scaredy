[Unit]
Description=Scaredy GmCat (signalling + encrypted relay; stores nothing)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/gmcat-scaredy
ExecStart=/usr/bin/python3 /opt/gmcat-scaredy/server.py
Environment=SCAREDY_PORT=4186
Environment=SCAREDY_ORIGINS=https://scaredy.gmcat.io
Restart=on-failure
RestartSec=3
MemoryMax=400M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
